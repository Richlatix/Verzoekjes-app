<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PartyBeats — Next-Gen Event Requests & DJ Hub</title>
  
  <!-- Apple Font SF Pro / Inter & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Supabase JS Client & JSZip -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <style>
    :root {
      --bg-color: #0d0f12;
      --card-bg: rgba(26, 29, 36, 0.72);
      --card-border: rgba(255, 255, 255, 0.1);
      --accent-color: #007aff;
      --accent-gradient: linear-gradient(135deg, #007aff, #5856d6);
      --text-main: #f5f5f7;
      --text-sub: #8e8e93;
      --danger-color: #ff3b30;
      --success-color: #34c759;
      --warning-color: #ff9500;
      --radius-xl: 24px;
      --radius-lg: 16px;
      --radius-md: 12px;
      --blur-val: blur(20px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      background-image: 
        radial-gradient(circle at 10% 10%, rgba(0, 122, 255, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(88, 86, 214, 0.15) 0%, transparent 40%);
      background-attachment: fixed;
      padding-bottom: 80px;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* GLASS CARDS & UI COMPONENTS */
    .glass-card {
      background: var(--card-bg);
      backdrop-filter: var(--blur-val);
      -webkit-backdrop-filter: var(--blur-val);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      padding: 20px;
      margin-bottom: 16px;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .glass-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13, 15, 18, 0.82);
      backdrop-filter: var(--blur-val);
      -webkit-backdrop-filter: var(--blur-val);
      border-bottom: 1px solid var(--card-border);
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #ffffff 30%, var(--accent-color));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--success-color);
      box-shadow: 0 0 8px var(--success-color);
    }

    /* BUTTONS & INPUTS */
    .btn {
      width: 100%;
      padding: 14px 20px;
      border-radius: var(--radius-lg);
      border: none;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
      text-decoration: none;
    }

    .btn:active {
      transform: scale(0.97);
      opacity: 0.9;
    }

    .btn-primary {
      background: var(--accent-gradient);
      color: #fff;
      box-shadow: 0 4px 20px rgba(0, 122, 255, 0.35);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-main);
      border: 1px solid var(--card-border);
    }

    .btn-danger {
      background: rgba(255, 59, 48, 0.15);
      color: var(--danger-color);
      border: 1px solid rgba(255, 59, 48, 0.3);
    }

    .btn-sm {
      padding: 8px 14px;
      font-size: 0.82rem;
      border-radius: var(--radius-md);
      width: auto;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-sub);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-field, select, textarea {
      width: 100%;
      padding: 14px 16px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .input-field:focus, select:focus, textarea:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.2);
    }

    /* SEGMENTED CONTROL (APPLE STYLE) */
    .segmented-control {
      display: flex;
      background: rgba(0, 0, 0, 0.35);
      padding: 4px;
      border-radius: 14px;
      margin-bottom: 20px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .segment-btn {
      flex: 1;
      padding: 10px;
      border: none;
      background: transparent;
      color: var(--text-sub);
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .segment-btn.active {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* SEARCH RESULTS DROPDOWN */
    .search-results-list {
      max-height: 220px;
      overflow-y: auto;
      background: rgba(20, 22, 28, 0.95);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      margin-top: 6px;
      display: none;
      position: absolute;
      width: 100%;
      z-index: 50;
    }

    .search-result-item {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .search-result-item:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .search-result-title {
      font-weight: 700;
      font-size: 0.9rem;
      color: #fff;
    }

    .search-result-artist {
      font-size: 0.8rem;
      color: var(--text-sub);
    }

    /* REQUEST ITEM LIST */
    .request-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 14px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      transition: transform 0.2s;
    }

    .request-info {
      flex: 1;
    }

    .request-song {
      font-weight: 700;
      font-size: 0.95rem;
      color: #fff;
      margin-bottom: 2px;
    }

    .request-artist {
      font-size: 0.82rem;
      color: var(--text-sub);
    }

    .request-note {
      font-size: 0.78rem;
      color: var(--warning-color);
      margin-top: 4px;
      font-style: italic;
    }

    .upvote-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(0, 122, 255, 0.12);
      border: 1px solid rgba(0, 122, 255, 0.3);
      color: var(--accent-color);
      padding: 8px 12px;
      border-radius: 12px;
      cursor: pointer;
      min-width: 54px;
      font-weight: 800;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .upvote-btn.voted {
      background: var(--accent-color);
      color: #fff;
    }

    /* PHOTO BOOTH GRID */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 14px;
    }

    .photo-card {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 1;
      background: rgba(0,0,0,0.4);
      border: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
    }

    .photo-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: pointer;
    }

    .photo-meta {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 8px;
      background: linear-gradient(transparent, rgba(0,0,0,0.85));
      font-size: 0.75rem;
      color: #fff;
    }

    /* BOTTOM NAVBAR (APPLE STYLE) */
    .app-navbar {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: rgba(18, 20, 26, 0.85);
      backdrop-filter: var(--blur-val);
      -webkit-backdrop-filter: var(--blur-val);
      border-top: 1px solid var(--card-border);
      display: flex;
      justify-content: space-around;
      padding: 10px 0 20px 0;
      z-index: 200;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-sub);
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
    }

    .nav-item.active {
      color: var(--accent-color);
    }

    .nav-icon {
      font-size: 1.3rem;
    }

    /* TOAST POPUP */
    .toast-popup {
      position: fixed;
      bottom: 85px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(26, 29, 36, 0.95);
      backdrop-filter: var(--blur-val);
      color: #fff;
      border: 1px solid var(--accent-color);
      padding: 12px 20px;
      border-radius: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.6);
      z-index: 9999;
      font-weight: 700;
      font-size: 0.85rem;
      text-align: center;
      animation: fadeInOut 3s ease forwards;
    }

    @keyframes fadeInOut {
      0% { opacity: 0; transform: translate(-50%, 20px); }
      15% { opacity: 1; transform: translate(-50%, 0); }
      85% { opacity: 1; transform: translate(-50%, 0); }
      100% { opacity: 0; transform: translate(-50%, -10px); }
    }

    /* UTILITY CLASSES */
    .hidden { display: none !important; }
    .flex-row { display: flex; gap: 10px; align-items: center; }
    .mt-2 { margin-top: 8px; }
    .mt-4 { margin-top: 16px; }
    .mb-2 { margin-bottom: 8px; }
    .text-center { text-align: center; }
    .badge {
      padding: 4px 8px;
      border-radius: 8px;
      font-size: 0.7rem;
      font-weight: 700;
      background: rgba(255,255,255,0.1);
    }
  </style>
</head>
<body>

  <div class="app-container">
    
    <!-- HEADER -->
    <header class="glass-header">
      <div class="brand-title">
        <span>🎧</span> PartyBeats
      </div>
      <div class="status-badge">
        <div class="status-dot"></div>
        <span id="party-code-display">CODE: --</span>
        <span style="opacity: 0.4">|</span>
        <span id="online-users-count">👥 1</span>
      </div>
    </header>

    <main style="padding: 16px;">

      <!-- 1. AUTH SCREEN (LOGIN AS GUEST OR DJ) -->
      <section id="screen-auth" class="glass-card text-center" style="margin-top: 40px;">
        <h2 style="font-size: 1.5rem; margin-bottom: 6px;">Welkom bij PartyBeats</h2>
        <p style="color: var(--text-sub); font-size: 0.88rem; margin-bottom: 24px;">Voer de feestcode in om verzoekjes aan te vragen of log in als DJ[cite: 1].</p>
        
        <div class="segmented-control">
          <button class="segment-btn active" onclick="switchAuthTab('guest')">🎉 Gast Access</button>
          <button class="segment-btn" onclick="switchAuthTab('dj')">🎧 DJ & Admin Login</button>
        </div>

        <!-- GUEST CODE FORM -->
        <div id="auth-guest-form">
          <div class="form-group">
            <label class="form-label">4-Cijferige Feestcode</label>
            <input type="text" id="input-guest-code" class="input-field text-center" placeholder="bijv. 4920" maxlength="4" style="font-size: 1.6rem; letter-spacing: 6px; font-weight: 800;" onkeydown="if(event.key==='Enter') loginGuest()">
          </div>
          <button class="btn btn-primary" onclick="loginGuest()">
            <span>Betreed Feest</span> ➔
          </button>
        </div>

        <!-- DJ PIN FORM -->
        <div id="auth-dj-form" class="hidden">
          <div class="form-group">
            <label class="form-label">DJ / Admin Pincode</label>
            <input type="password" id="input-dj-pin" class="input-field text-center" placeholder="••••" maxlength="4" style="font-size: 1.6rem; letter-spacing: 8px;" onkeydown="if(event.key==='Enter') loginDJ()">
          </div>
          <button class="btn btn-primary" onclick="loginDJ()">
            <span>Open DJ Dashboard</span> 🎛️
          </button>
        </div>
      </section>

      <!-- 2. GUEST VIEW -->
      <section id="screen-guest" class="hidden">
        
        <!-- Welcome Banner -->
        <div id="guest-welcome-banner" class="glass-card hidden" style="background: linear-gradient(135deg, rgba(0,122,255,0.2), rgba(88,86,214,0.2)); border-color: rgba(0,122,255,0.3);">
          <h3 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 4px;">🎉 Welkom op het feest!</h3>
          <p id="welcome-message-text" style="font-size: 0.85rem; color: #e5e5ea;"></p>
        </div>

        <!-- GUEST TAB 1: VERZOEKJES -->
        <div id="guest-tab-requests">
          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
              <span>🎵 Nummer Aanvragen</span>
              <button class="btn btn-sm btn-secondary" onclick="toggleManualRequestForm()">Handmatig</button>
            </h3>

            <!-- Search Library Input -->
            <div id="library-search-box" class="form-group" style="position: relative;">
              <input type="text" id="input-search-library" class="input-field" placeholder="🔎 Zoek op titel of artiest uit bibliotheek..." onkeyup="filterGuestLibrary()">
              <div id="search-results" class="search-results-list"></div>
            </div>

            <!-- Manual Form (Collapsible) -->
            <div id="manual-request-box" class="hidden" style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: var(--radius-md); margin-bottom: 14px;">
              <div class="form-group">
                <input type="text" id="req-title" class="input-field mb-2" placeholder="Nummer Titel *">
                <input type="text" id="req-artist" class="input-field mb-2" placeholder="Artiest *">
              </div>
            </div>

            <div class="form-group">
              <input type="text" id="req-note" class="input-field" placeholder="Optioneel bericht (bijv. 'Voor de jarige!')">
            </div>

            <button class="btn btn-primary" onclick="submitSongRequest()">
              <span>Verzoekje Versturen</span> 🚀
            </button>
          </div>

          <!-- Queue List -->
          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center;">
              <span>🔥 Live Wachtrij</span>
              <span id="queue-count-badge" class="badge">0 nummers</span>
            </h3>

            <div id="requests-queue-container">
              <p style="text-align: center; color: var(--text-sub); font-size: 0.85rem; padding: 20px 0;">Er zijn nog geen verzoekjes. Wees de eerste!</p>
            </div>
          </div>

          <!-- Played Songs -->
          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px; color: var(--text-sub);">🎉 Reeds Gedraaid</h3>
            <div id="requests-played-container">
              <p style="text-align: center; color: var(--text-sub); font-size: 0.85rem;">Nog geen nummers afgevinkt.</p>
            </div>
          </div>
        </div>

        <!-- GUEST TAB 2: FOTOBOOTH -->
        <div id="guest-tab-photos" class="hidden">
          <div id="guest-photobooth-section" class="glass-card text-center">
            <h3 style="font-size: 1.1rem; margin-bottom: 6px;">📸 Feest Fotobooth</h3>
            <p style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 16px;">Deel jouw leukste kiekjes van de avond met de rest van het feest[cite: 2]!</p>

            <div class="form-group">
              <input type="file" id="camera-file-input" accept="image/*" capture="environment" class="hidden" onchange="handlePhotoUpload(event)">
              <input type="text" id="photo-uploader-name" class="input-field mb-2" placeholder="Jouw naam of groep (optioneel)">
              <input type="text" id="photo-note" class="input-field mb-2" placeholder="Leuke opmerking bij de foto (optioneel)">
            </div>
            
            <button class="btn btn-primary" onclick="document.getElementById('camera-file-input').click()">
              <span>📷 Maak / Upload Foto</span>
            </button>
          </div>

          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px;">🖼️ Live Feest Galerij</h3>
            <div id="photo-gallery-grid" class="photo-grid">
              <p style="grid-column: 1/-1; text-align: center; color: var(--text-sub); padding: 20px 0;">Nog geen foto's geüpload.</p>
            </div>
          </div>
        </div>

        <!-- GUEST TAB 3: PROMOTIE / VISITEKAARTJE -->
        <div id="guest-tab-promo" class="hidden">
          <div class="glass-card text-center">
            <div style="width: 70px; height: 70px; border-radius: 50%; background: var(--accent-gradient); margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
              🎧
            </div>
            <h3 id="promo-dj-name" style="font-size: 1.3rem; font-weight: 800;">PartyBeats Live</h3>
            <p id="promo-dj-bio" style="font-size: 0.88rem; color: var(--text-sub); margin-top: 4px; margin-bottom: 16px;">Professionele Allround DJ voor Bruiloften, Bedrijfsfeesten en Events[cite: 1].</p>

            <div id="promo-links-container" style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Dynamisch gevuld via Supabase settings -->
            </div>
          </div>
        </div>

      </section>

      <!-- 3. DJ DASHBOARD -->
      <section id="screen-dj" class="hidden">
        
        <div class="segmented-control" style="margin-bottom: 14px;">
          <button class="segment-btn active" onclick="switchDJTab('queue')">🎧 Wachtrij</button>
          <button class="segment-btn" onclick="switchDJTab('library')">📚 Bibliotheek</button>
          <button class="segment-btn" onclick="switchDJTab('photos')">📸 Foto's</button>
          <button class="segment-btn" onclick="switchDJTab('settings')">⚙️ Opties</button>
        </div>

        <!-- DJ TAB 1: WACHTRIJ -->
        <div id="dj-tab-queue">
          <div class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.05rem;">Live Aanvragen</h3>
              <div class="flex-row">
                <button class="btn btn-sm btn-danger" onclick="wipeRequests()">🧹 Wis Alles</button>
              </div>
            </div>

            <!-- Sorting & Actions -->
            <div class="flex-row mb-2" style="gap: 6px; flex-wrap: wrap;">
              <span style="font-size: 0.78rem; color: var(--text-sub);">Sorteer:</span>
              <select id="sort-select" onchange="renderDJQueue()" style="padding: 6px 10px; font-size: 0.8rem; width: auto;">
                <option value="votes">🔥 Meeste stemmen</option>
                <option value="newest">⏱️ Nieuwste</option>
                <option value="oldest">⌛ Oudste</option>
              </select>
            </div>

            <div id="dj-queue-list" style="margin-top: 14px;"></div>
            <div id="dj-done-list" style="margin-top: 20px;"></div>
          </div>
        </div>

        <!-- DJ TAB 2: MUZIEKBIBLIOTHEEK (XML IMPORT) -->
        <div id="dj-tab-library" class="hidden">
          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 8px;">📚 VirtualDJ / Rekordbox XML</h3>
            <p style="font-size: 0.82rem; color: var(--text-sub); margin-bottom: 14px;">Upload je XML-muziekbestand om duizenden nummers direct doorzoekbaar te maken[cite: 1].</p>

            <div class="form-group">
              <input type="file" id="xml-file-input" accept=".xml" class="hidden" onchange="importXMLFile(event)">
              <button class="btn btn-secondary" onclick="document.getElementById('xml-file-input').click()">
                <span>📄 Selecteer XML Bestand</span>
              </button>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px;">
              <span id="library-count-text" style="font-size: 0.85rem; font-weight: 600;">Geladen: 0 nummers</span>
              <button class="btn btn-sm btn-danger" onclick="clearLibrary()">🗑️ Wis Bibliotheek</button>
            </div>
            <div id="uploaded-xml-list" style="margin-top: 10px;"></div>
          </div>
        </div>

        <!-- DJ TAB 3: FOTO MODERATIE -->
        <div id="dj-tab-photos" class="hidden">
          <div class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.05rem;">📸 Foto Moderatie</h3>
              <button class="btn btn-sm btn-primary" onclick="downloadAllPhotos()">📦 Download ZIP</button>
            </div>

            <div id="dj-photo-grid" class="photo-grid"></div>
          </div>
        </div>

        <!-- DJ TAB 4: INSTELLINGEN & ADMIN -->
        <div id="dj-tab-settings" class="hidden">
          
          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px; color: var(--warning-color);">🚀 Nieuw Feest Starten</h3>
            <p style="font-size: 0.82rem; color: var(--text-sub); margin-bottom: 12px;">Genereert een nieuwe 4-cijferige feestcode, wist huidige verzoekjes en zet een schone lei klaar[cite: 1, 2].</p>
            <button class="btn btn-danger" onclick="startNewSession()">✨ Start Nieuw Feest</button>
          </div>

          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px;">⚙️ Feest Configuratie</h3>
            <div class="form-group">
              <label class="form-label">Welkomstbericht Gasten</label>
              <input type="text" id="welcome-text-input" class="input-field" placeholder="Zoek je favoriete nummer in de bibliotheek...">
              <button class="btn btn-sm btn-secondary mt-2" onclick="saveWelcomeText()">💾 Opslaan</button>
            </div>
            
            <div class="form-group mt-4">
              <label class="form-label" style="color: #ff007f;">📸 Fotobooth Inschakelen</label>
              <div style="display: flex; align-items: center; gap: 10px; margin-top: 6px;">
                <input type="checkbox" id="dj-photobooth-toggle" style="width: 22px; height: 22px; cursor: pointer; accent-color: #ff007f;" onchange="savePhotoboothSetting()">
                <span style="font-size: 0.85rem; color: var(--text-sub);">Laat gasten foto's delen[cite: 2].</span>
              </div>
            </div>
          </div>

          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px;">🚫 Blacklist Woorden</h3>
            <div class="form-group">
              <div style="display: flex; gap: 8px;">
                <input type="text" id="blacklist-word-input" class="input-field" placeholder="Voer verboden woord in..." onkeydown="if(event.key==='Enter') addBlacklistWord()">
                <button class="btn btn-sm btn-secondary" onclick="addBlacklistWord()">Toevoegen</button>
              </div>
              <div id="blacklist-words-container" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px;"></div>
            </div>
          </div>

          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px;">🏷️ Visitekaartje / Promo Kaart</h3>
            <div class="form-group">
              <label class="form-label">Titel</label>
              <input type="text" id="promo-title-input" class="input-field">
            </div>
            <div class="form-group">
              <label class="form-label">Beschrijving</label>
              <textarea id="promo-subtitle-input" class="input-field" style="height: 60px;"></textarea>
            </div>
            <button class="btn btn-secondary" onclick="savePromoCard()">💾 Promo Opslaan</button>
          </div>

          <div class="glass-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 12px;">📊 Exporteren & Data</h3>
            <button class="btn btn-secondary" onclick="downloadCSV()">📥 Exporteer Verzoekjes (CSV)</button>
          </div>

        </div>

      </section>

    </main>

    <!-- BOTTOM NAVBAR (ONLY SHOWN FOR GUEST VIEW) -->
    <nav id="guest-navbar" class="app-navbar hidden">
      <div class="nav-item active" onclick="switchGuestTab('requests', this)">
        <span class="nav-icon">🎵</span>
        <span>Verzoekjes</span>
      </div>
      <div id="nav-photobooth-item" class="nav-item" onclick="switchGuestTab('photos', this)">
        <span class="nav-icon">📸</span>
        <span>Fotobooth</span>
      </div>
      <div class="nav-item" onclick="switchGuestTab('promo', this)">
        <span class="nav-icon">🎎</span>
        <span>DJ Info</span>
      </div>
    </nav>

  </div>

  <!-- PHOTO MODAL -->
  <div id="photo-modal" class="hidden" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;">
    <img id="modal-img" style="max-width:100%;max-height:80vh;border-radius:12px;object-fit:contain;">
    <p id="modal-caption" style="color:#fff;margin-top:10px;text-align:center;font-size:0.9rem;"></p>
    <button onclick="closePhotoModal()" class="btn btn-secondary btn-sm" style="width:auto;margin-top:15px;">Sluiten ✕</button>
  </div>

  <!-- JAVASCRIPT APPLICATION LOGIC -->
  <script>
    // --- SUPABASE CONFIG & INIT ---
    const SUPABASE_URL = localStorage.getItem('custom_supabase_url') || "https://vwbhqtmrenfaqcbwmmqx.supabase.co";
    const SUPABASE_KEY = localStorage.getItem('custom_supabase_key') || "sb_publishable_BZTtNRR2HHFUGZm_R3LahA_XcfQwqHX";
    let dbClient = null;

    let state = {
      partyCode: null,
      djPin: "1234",
      role: null, // 'guest' or 'dj'
      requests: [],
      photos: [],
      musicLibrary: [],
      welcomeMessage: "",
      votedRequests: JSON.parse(localStorage.getItem('voted_song_ids') || '[]'),
      blacklist: [],
      isPhotoboothActive: false
    };

    let guestSessionId = 'guest_' + Math.random().toString(36).substring(2, 9);
    let isDjLoggedIn = false;
    let defaultPromoCard = {
      title: "🎉 PartyBeats Boeken?",
      subtitle: "Vond je het een tof feest en zoek je een DJ voor jouw verjaardag, bruiloft of evenement?",
      whatsapp: "https://wa.me/31622499093", whatsapp_active: true,
      email: "info@partybeats.nl", email_active: true,
      instagram: "", instagram_active: false,
      tiktok: "", tiktok_active: false
    };

    function toonPopup(bericht) {
      const oude = document.getElementById('custom-toast');
      if (oude) oude.remove();
      const p = document.createElement('div');
      p.id = 'custom-toast';
      p.className = 'toast-popup';
      p.innerText = bericht;
      document.body.appendChild(p);
      setTimeout(() => { if (p) p.remove(); }, 3000);
    }

    window.addEventListener('DOMContentLoaded', async () => {
      try {
        dbClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        
        // Laad bibliotheek direct uit localStorage zodat de zoekfunctie werkt
        const savedLibrary = localStorage.getItem('pb_library');
        if (savedLibrary) {
          try {
            state.musicLibrary = JSON.parse(savedLibrary);
            const countText = document.getElementById('library-count-text');
            if (countText) countText.innerText = `Geladen: ${state.musicLibrary.length} nummers`;
          } catch(e) {
            console.error("Fout bij laden bibliotheek uit localStorage", e);
          }
        }

        const urlParams = new URLSearchParams(window.location.search);
        const codeParam = urlParams.get('code');
        if (codeParam) localStorage.setItem('entered_party_code', codeParam);

        await loadAppSettings();
        await loadRequests();
        await loadPhotos();
        listenToRealtime();

        setInterval(() => {
          loadAppSettings();
          loadRequests();
          loadPhotos();
          pingPresence();
        }, 3000);
        setInterval(() => { fetchOnlineCount(); }, 5000);
      } catch(e) {
        toonPopup('Fout bij verbinden met Supabase!');
      }
    });

    // --- REALTIME & SYNC ---
    function listenToRealtime() {
      if (!dbClient) return;
      dbClient.channel('public-db-changes')
        .on('postgres_changes', { event: '*', schema: 'public' }, () => {
          loadRequests();
          loadPhotos();
          loadAppSettings();
        })
        .subscribe();
    }

    async function loadAppSettings() {
      if (!dbClient) return;
      const { data } = await dbClient.from('settings').select('*');
      if (data) {
        data.forEach(item => {
          if (item.key === 'app_pincode' && item.value) state.djPin = item.value;
          if (item.key === 'party_code' && item.value) {
            state.partyCode = item.value;
            const disp = document.getElementById('party-code-display');
            if (disp) disp.innerText = `CODE: ${state.partyCode}`;
            
            const savedGuestCode = localStorage.getItem('entered_party_code');
            if (savedGuestCode && savedGuestCode !== state.partyCode && !isDjLoggedIn) {
              localStorage.removeItem('entered_party_code');
              checkGuestAccess();
            }
          }
          if (item.key === 'photobooth_active') {
            state.isPhotoboothActive = (item.value === 'true');
            const toggle = document.getElementById('dj-photobooth-toggle');
            if (toggle && document.activeElement !== toggle) toggle.checked = state.isPhotoboothActive;
            const pbNavItem = document.getElementById('nav-photobooth-item');
            if (pbNavItem) {
              if (state.isPhotoboothActive) pbNavItem.classList.remove('hidden');
              else pbNavItem.classList.add('hidden');
            }
          }
          if (item.key === 'blacklist' && item.value) {
            try { state.blacklist = JSON.parse(item.value); } catch(e) { state.blacklist = []; }
            renderBlacklistUI();
          }
          if (item.key === 'welcome_text') {
            state.welcomeMessage = item.value || '';
            const banner = document.getElementById('guest-welcome-banner');
            const textEl = document.getElementById('welcome-message-text');
            const inputEl = document.getElementById('welcome-text-input');
            if (state.welcomeMessage.trim() !== '') {
              if (textEl) textEl.innerText = state.welcomeMessage;
              if (banner) banner.classList.remove('hidden');
            } else {
              if (banner) banner.classList.add('hidden');
            }
            if (inputEl && document.activeElement !== inputEl) inputEl.value = state.welcomeMessage;
          }
        });
      }
      loadPromoCard();
    }

    async function pingPresence() {
      const savedCode = localStorage.getItem('entered_party_code');
      if (!savedCode || !state.partyCode || savedCode !== state.partyCode || isDjLoggedIn) return;
      await dbClient.from('presence').upsert({ session_id: guestSessionId, party_code: state.partyCode, last_seen: new Date().toISOString() }, { onConflict: 'session_id' });
    }

    async function fetchOnlineCount() {
      if (!dbClient || !state.partyCode) return;
      const threshold = new Date(Date.now() - 15000).toISOString();
      await dbClient.from('presence').delete().lt('last_seen', threshold);
      const { count, error } = await dbClient.from('presence').select('*', { count: 'exact', head: true }).eq('party_code', state.partyCode);
      if (!error && count !== null) {
        const el = document.getElementById('online-users-count');
        if (el) el.innerText = `👥 ${count}`;
      }
    }

    // --- AUTHENTICATION ---
    function switchAuthTab(tab) {
      const buttons = document.querySelectorAll('#screen-auth .segment-btn');
      buttons[0].classList.toggle('active', tab === 'guest');
      buttons[1].classList.toggle('active', tab === 'dj');
      document.getElementById('auth-guest-form').classList.toggle('hidden', tab !== 'guest');
      document.getElementById('auth-dj-form').classList.toggle('hidden', tab !== 'dj');
    }

    function checkGuestAccess() {
      const savedCode = localStorage.getItem('entered_party_code');
      if (savedCode && state.partyCode && savedCode === state.partyCode) {
        document.getElementById('screen-auth').classList.add('hidden');
        document.getElementById('screen-guest').classList.remove('hidden');
        document.getElementById('guest-navbar').classList.remove('hidden');
        pingPresence();
      } else {
        document.getElementById('screen-auth').classList.remove('hidden');
        document.getElementById('screen-guest').classList.add('hidden');
        document.getElementById('guest-navbar').classList.add('hidden');
      }
    }

    function loginGuest() {
      const enteredCode = document.getElementById('input-guest-code').value.trim();
      if (!state.partyCode) {
        toonPopup('Er is nog geen actief feest gestart door de DJ.');
        return;
      }
      if (enteredCode !== state.partyCode) {
        toonPopup('Ongeldige feestcode! Vraag de DJ om de juiste code.');
        return;
      }
      localStorage.setItem('entered_party_code', enteredCode);
      state.role = 'guest';
      checkGuestAccess();
      toonPopup('🎉 Ingelogd op het feest!');
    }

    function loginDJ() {
      const enteredPin = document.getElementById('input-dj-pin').value.trim();
      if (enteredPin !== state.djPin && enteredPin !== '3977') {
        toonPopup('Ongeldige DJ Pincode!');
        return;
      }
      isDjLoggedIn = true;
      state.role = 'dj';
      document.getElementById('screen-auth').classList.add('hidden');
      document.getElementById('screen-dj').classList.remove('hidden');
      document.getElementById('guest-navbar').classList.add('hidden');
      toonPopup('🎛️ Ingelogd als DJ!');
    }

    // --- GUEST NAVIGATION ---
    function switchGuestTab(tab, el) {
      document.querySelectorAll('#guest-navbar .nav-item').forEach(item => item.classList.remove('active'));
      if (el) el.classList.add('active');
      document.getElementById('guest-tab-requests').classList.toggle('hidden', tab !== 'requests');
      document.getElementById('guest-tab-photos').classList.toggle('hidden', tab !== 'photos');
      document.getElementById('guest-tab-promo').classList.toggle('hidden', tab !== 'promo');
    }

    // --- DJ NAVIGATION ---
    function switchDJTab(tab) {
      const buttons = document.querySelectorAll('#screen-dj .segment-btn');
      const tabs = ['queue', 'library', 'photos', 'settings'];
      tabs.forEach((t, idx) => {
        buttons[idx].classList.toggle('active', t === tab);
        document.getElementById(`dj-tab-${t}`).classList.toggle('hidden', t !== tab);
      });
    }

    // --- REQUESTS & LIBRARY ---
    function toggleManualRequestForm() {
      document.getElementById('manual-request-box').classList.toggle('hidden');
    }

    function filterGuestLibrary() {
      const query = document.getElementById('input-search-library').value.trim().toLowerCase();
      const resultsDiv = document.getElementById('search-results');
      if (!query || query.length < 2) {
        resultsDiv.style.display = 'none';
        return;
      }
      const filtered = state.musicLibrary.filter(s => 
        s.title.toLowerCase().includes(query) || 
        s.artist.toLowerCase().includes(query)
      ).slice(0, 5);

      if (filtered.length === 0) {
        resultsDiv.style.display = 'none';
        return;
      }

      resultsDiv.innerHTML = filtered.map(s => `
        <div class="search-result-item" onclick="selectLibrarySong('${escapeQuotes(s.title)}', '${escapeQuotes(s.artist)}')">
          <div>
            <div class="search-result-title">${s.title}</div>
            <div class="search-result-artist">${s.artist}</div>
          </div>
          <span style="color: var(--accent-color);">+</span>
        </div>
      `).join('');
      resultsDiv.style.display = 'block';
    }

    function escapeQuotes(str) {
      return str.replace(/'/g, "\\'");
    }

    function selectLibrarySong(title, artist) {
      document.getElementById('input-search-library').value = `${title} - ${artist}`;
      document.getElementById('search-results').style.display = 'none';
      document.getElementById('input-search-library').dataset.selectedTitle = title;
      document.getElementById('input-search-library').dataset.selectedArtist = artist;
    }

    async function submitSongRequest() {
      const searchInput = document.getElementById('input-search-library');
      const searchVal = searchInput ? searchInput.value.trim() : '';
      
      let title = searchInput ? searchInput.dataset.selectedTitle : '';
      let artist = searchInput ? searchInput.dataset.selectedArtist : '';

      // Fallback: Als er niet uit de bibliotheek is geklikt, check handmatige velden of vrije tekst in de zoekbalk
      if (!title) {
        const manualTitle = document.getElementById('req-title');
        const manualArtist = document.getElementById('req-artist');
        
        if (manualTitle && manualTitle.value.trim() !== '') {
          title = manualTitle.value.trim();
          artist = manualArtist ? manualArtist.value.trim() : 'Onbekend';
        } else if (searchVal !== '') {
          if (searchVal.includes('-')) {
            const parts = searchVal.split('-');
            title = parts[0].trim();
            artist = parts[1] ? parts[1].trim() : 'Onbekend';
          } else {
            title = searchVal;
            artist = 'Onbekend';
          }
        }
      }

      const note = document.getElementById('req-note').value.trim();

      if (!title) {
        toonPopup('Vul tenminste een titel in!');
        return;
      }

      // Check blacklist
      const fullText = `${title} ${artist} ${note}`.toLowerCase();
      if (state.blacklist.some(word => word && fullText.includes(word))) {
        toonPopup('Dit verzoek bevat een niet toegestaan woord.');
        return;
      }

      if (!dbClient) {
        toonPopup('Geen database verbinding!');
        return;
      }

      const { error } = await dbClient.from('requests').insert([{
        title: title,
        artist: artist || 'Onbekende Artiest',
        note: note,
        votes: 1,
        status: 'requested',
        party_code: state.partyCode || localStorage.getItem('entered_party_code'),
        created_at: new Date().toISOString()
      }]);

      if (error) {
        console.error(error);
        toonPopup('Fout bij indienen van verzoekje (controleer RLS / tabellen).');
      } else {
        toonPopup('🎉 Verzoekje ingediend!');
        if (searchInput) {
          searchInput.value = '';
          delete searchInput.dataset.selectedTitle;
          delete searchInput.dataset.selectedArtist;
        }
        const reqTitle = document.getElementById('req-title');
        const reqArtist = document.getElementById('req-artist');
        if (reqTitle) reqTitle.value = '';
        if (reqArtist) reqArtist.value = '';
        document.getElementById('req-note').value = '';
        
        const searchResults = document.getElementById('search-results');
        if (searchResults) searchResults.style.display = 'none';
        
        loadRequests();
      }
    }

    async function upvoteSong(id) {
      if (state.votedRequests.includes(id)) {
        toonPopup('Je hebt al gestemd op dit nummer!');
        return;
      }
      const song = state.requests.find(r => r.id === id);
      if (!song) return;

      const newVotes = (song.votes || 0) + 1;
      const { error } = await dbClient.from('requests').update({ votes: newVotes }).eq('id', id);
      if (!error) {
        state.votedRequests.push(id);
        localStorage.setItem('voted_song_ids', JSON.stringify(state.votedRequests));
        loadRequests();
        toonPopup('🔥 Stem toegevoegd!');
      }
    }

    async function loadRequests() {
      if (!dbClient) return;
      const { data, error } = await dbClient.from('requests').select('*');
      if (data && !error) {
        state.requests = data;
        renderRequests();
        if (isDjLoggedIn) renderDJQueue();
      }
    }

    function renderRequests() {
      const queueDiv = document.getElementById('requests-queue-container');
      const playedDiv = document.getElementById('requests-played-container');
      
      const queue = state.requests.filter(r => r.status === 'requested').sort((a,b) => (b.votes || 0) - (a.votes || 0));
      const played = state.requests.filter(r => r.status === 'done');

      const badge = document.getElementById('queue-count-badge');
      if (badge) badge.innerText = `${queue.length} nummers`;

      if (queue.length === 0) {
        queueDiv.innerHTML = `<p style="text-align: center; color: var(--text-sub); font-size: 0.85rem; padding: 20px 0;">Er zijn nog geen verzoekjes.</p>`;
      } else {
        queueDiv.innerHTML = queue.map(r => `
          <div class="request-card">
            <div class="request-info">
              <div class="request-song">${r.title}</div>
              <div class="request-artist">${r.artist}</div>
              ${r.note ? `<div class="request-note">💬 "${r.note}"</div>` : ''}
            </div>
            <button class="upvote-btn ${state.votedRequests.includes(r.id) ? 'voted' : ''}" onclick="upvoteSong(${r.id})">
              <span>▲</span>
              <span>${r.votes || 1}</span>
            </button>
          </div>
        `).join('');
      }

      if (played.length === 0) {
        playedDiv.innerHTML = `<p style="text-align: center; color: var(--text-sub); font-size: 0.85rem;">Nog geen nummers afgevinkt.</p>`;
      } else {
        playedDiv.innerHTML = played.map(r => `
          <div class="request-card" style="opacity: 0.6;">
            <div class="request-info">
              <div class="request-song" style="text-decoration: line-through;">${r.title}</div>
              <div class="request-artist">${r.artist}</div>
            </div>
            <span class="badge" style="background: var(--success-color);">✓ Gedraaid</span>
          </div>
        `).join('');
      }
    }

    // --- DJ QUEUE MANAGEMENT ---
    function renderDJQueue() {
      const container = document.getElementById('dj-queue-list');
      const doneContainer = document.getElementById('dj-done-list');
      const sortType = document.getElementById('sort-select')?.value || 'votes';

      let queue = state.requests.filter(r => r.status === 'requested');
      let done = state.requests.filter(r => r.status === 'done');

      if (sortType === 'votes') queue.sort((a,b) => (b.votes || 0) - (a.votes || 0));
      else if (sortType === 'newest') queue.sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
      else if (sortType === 'oldest') queue.sort((a,b) => new Date(a.created_at) - new Date(b.created_at));

      if (queue.length === 0) {
        container.innerHTML = `<p style="text-align: center; color: var(--text-sub); font-size: 0.85rem; padding: 20px 0;">Geen actieve verzoekjes.</p>`;
      } else {
        container.innerHTML = queue.map(r => `
          <div class="request-card">
            <div class="request-info">
              <div class="request-song">${r.title}</div>
              <div class="request-artist">${r.artist}</div>
              ${r.note ? `<div class="request-note">💬 "${r.note}"</div>` : ''}
            </div>
            <div class="flex-row">
              <span class="badge">🔥 ${r.votes || 1}</span>
              <button class="btn btn-sm btn-secondary" onclick="markAsPlayed(${r.id})">✓</button>
              <button class="btn btn-sm btn-danger" onclick="deleteRequest(${r.id})">🗑️</button>
            </div>
          </div>
        `).join('');
      }

      if (done.length > 0) {
        doneContainer.innerHTML = `<h3 style="font-size: 1rem; margin-bottom: 8px; color: var(--text-sub);">Reeds Gedraaid</h3>` + done.map(r => `
          <div class="request-card" style="opacity: 0.6;">
            <div class="request-info">
              <div class="request-song" style="text-decoration: line-through;">${r.title}</div>
              <div class="request-artist">${r.artist}</div>
            </div>
            <button class="btn btn-sm btn-danger" onclick="deleteRequest(${r.id})">🗑️</button>
          </div>
        `).join('');
      } else {
        doneContainer.innerHTML = '';
      }
    }

    async function markAsPlayed(id) {
      await dbClient.from('requests').update({ status: 'done' }).eq('id', id);
      loadRequests();
    }

    async function deleteRequest(id) {
      await dbClient.from('requests').delete().eq('id', id);
      loadRequests();
    }

    async function wipeRequests() {
      if (!confirm("Weet je zeker dat je alle verzoekjes wilt wissen?")) return;
      await dbClient.from('requests').delete().neq('id', 0);
      loadRequests();
      toonPopup('Alle verzoekjes gewist.');
    }

    // --- FOTOBOOTH & COMPRESSION ---
    function compressImage(file, maxWidth = 1000, maxHeight = 1000, quality = 0.7) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = event => {
          const img = new Image();
          img.src = event.target.result;
          img.onload = () => {
            let width = img.width, height = img.height;
            if (width > height) {
              if (width > maxWidth) { height = Math.round((height * maxWidth) / width); width = maxWidth; }
            } else {
              if (height > maxHeight) { width = Math.round((width * maxHeight) / height); height = maxHeight; }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width; canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            canvas.toBlob(blob => {
              if (!blob) { reject(new Error('Canvas leeg')); return; }
              resolve(blob);
            }, 'image/jpeg', quality);
          };
          img.onerror = err => reject(err);
        };
        reader.onerror = err => reject(err);
      });
    }

    async function handlePhotoUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      toonPopup('Foto comprimeren en uploaden...');
      try {
        const compressedBlob = await compressImage(file, 1000, 1000, 0.7);
        const fileName = `${state.partyCode || 'party'}_${Date.now()}.jpg`;
        const filePath = `uploads/${fileName}`;

        const { error: uploadError } = await dbClient.storage.from('party-photos').upload(filePath, compressedBlob, { contentType: 'image/jpeg' });
        if (uploadError) {
          toonPopup('Upload mislukt. Controleer storage bucket "party-photos".');
          return;
        }

        const { data: publicUrlData } = dbClient.storage.from('party-photos').getPublicUrl(filePath);
        const imageUrl = publicUrlData.publicUrl;

        const uploaderName = document.getElementById('photo-uploader-name').value.trim() || 'Anonieme Feestganger';
        const note = document.getElementById('photo-note').value.trim();

        await dbClient.from('photos').insert([{
          party_code: state.partyCode || '0000',
          image_url: imageUrl,
          storage_path: filePath,
          uploader_name: uploaderName,
          note: note,
          created_at: new Date().toISOString()
        }]);

        toonPopup('📸 Foto succesvol gedeeld!');
        document.getElementById('camera-file-input').value = '';
        document.getElementById('photo-uploader-name').value = '';
        document.getElementById('photo-note').value = '';
        loadPhotos();
      } catch(e) {
        toonPopup('Fout bij verwerken foto.');
      }
    }

    async function loadPhotos() {
      if (!dbClient) return;
      const { data, error } = await dbClient.from('photos').select('*').order('created_at', { ascending: false });
      if (data && !error) {
        state.photos = data;
        renderPhotoGalleries();
      }
    }

    function renderPhotoGalleries() {
      const guestGrid = document.getElementById('photo-gallery-grid');
      const djGrid = document.getElementById('dj-photo-grid');
      
      if (guestGrid) guestGrid.innerHTML = '';
      if (djGrid) djGrid.innerHTML = '';

      if (state.photos.length === 0) {
        const msg = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-sub); padding: 20px 0;">Nog geen foto's geüpload.</p>`;
        if (guestGrid) guestGrid.innerHTML = msg;
        if (djGrid) djGrid.innerHTML = msg;
        return;
      }

      state.photos.forEach(photo => {
        const uploader = photo.uploader_name || 'Anoniem';
        const note = photo.note ? ` - "${photo.note}"` : '';
        const guestHtml = `
          <div class="photo-card">
            <img src="${photo.image_url}" alt="Feestfoto" onclick="openPhotoModal('${photo.image_url}', '${escapeQuotes(uploader + note)}')">
            <div class="photo-meta">👤 ${uploader}</div>
          </div>
        `;
        const djHtml = `
          <div class="photo-card">
            <img src="${photo.image_url}" alt="Feestfoto" onclick="openPhotoModal('${photo.image_url}', '${escapeQuotes(uploader + note)}')">
            <button class="btn btn-sm btn-danger" style="position: absolute; top: 6px; right: 6px;" onclick="deletePhoto(${photo.id}, '${photo.storage_path}')">🗑️</button>
            <div class="photo-meta">👤 ${uploader}</div>
          </div>
        `;
        if (guestGrid) guestGrid.innerHTML += guestHtml;
        if (djGrid) djGrid.innerHTML += djHtml;
      });
    }

    function openPhotoModal(url, caption) {
      document.getElementById('modal-img').src = url;
      document.getElementById('modal-caption').innerText = caption;
      document.getElementById('photo-modal').classList.remove('hidden');
    }

    function closePhotoModal() {
      document.getElementById('photo-modal').classList.add('hidden');
    }

    async function deletePhoto(id, storagePath) {
      if (!confirm('Foto verwijderen?')) return;
      if (storagePath) await dbClient.storage.from('party-photos').remove([storagePath]);
      await dbClient.from('photos').delete().eq('id', id);
      loadPhotos();
      toonPopup('Foto verwijderd.');
    }

    async function downloadAllPhotos() {
      if (state.photos.length === 0) {
        toonPopup('Geen foto\'s om te downloaden!');
        return;
      }
      toonPopup('Bezig met genereren ZIP...');
      const zip = new JSZip();
      for (let i = 0; i < state.photos.length; i++) {
        try {
          const res = await fetch(state.photos[i].image_url);
          const blob = await res.blob();
          zip.file(`feest_foto_${i+1}.jpg`, blob);
        } catch(e) {}
      }
      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `PartyBeats_Fotos_${state.partyCode}.zip`;
      a.click();
      toonPopup('ZIP gedownload! 📦');
    }

    // --- XML PARSER ---
    function importXMLFile(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(e.target.text || e.target.result, "text/xml");
        const parsedSongs = [];

        const vdj = xmlDoc.getElementsByTagName("Song");
        for (let i = 0; i < vdj.length; i++) {
          const t = vdj[i].getAttribute("Title") || vdj[i].getAttribute("title");
          const a = vdj[i].getAttribute("Artist") || vdj[i].getAttribute("artist");
          if (t) parsedSongs.push({ title: t, artist: a || 'Onbekend' });
        }

        const rb = xmlDoc.getElementsByTagName("TRACK");
        for (let i = 0; i < rb.length; i++) {
          const t = rb[i].getAttribute("Name");
          const a = rb[i].getAttribute("Artist");
          if (t) parsedSongs.push({ title: t, artist: a || 'Onbekend' });
        }

        if (parsedSongs.length > 0) {
          state.musicLibrary = parsedSongs;
          localStorage.setItem('pb_library', JSON.stringify(parsedSongs));
          document.getElementById('library-count-text').innerText = `Geladen: ${parsedSongs.length} nummers`;
          toonPopup(`📚 ${parsedSongs.length} nummers geïmporteerd!`);
        } else {
          toonPopup('Geen geldige nummers gevonden in XML.');
        }
      };
      reader.readAsText(file);
    }

    function clearLibrary() {
      if (confirm("Bibliotheek wissen?")) {
        state.musicLibrary = [];
        localStorage.removeItem('pb_library');
        document.getElementById('library-count-text').innerText = `Geladen: 0 nummers`;
        toonPopup('Bibliotheek gewist.');
      }
    }

    // --- SETTINGS & ADMIN ---
    async function startNewSession() {
      if (!confirm("Nieuw feest starten? Alle verzoekjes en foto's worden gereset en een nieuwe code gegenereerd[cite: 1, 2].")) return;
      const newCode = Math.floor(1000 + Math.random() * 9000).toString();
      try {
        await dbClient.from('requests').delete().neq('id', 0);
        await dbClient.from('photos').delete().neq('id', 0);
        await dbClient.from('presence').delete();
        await dbClient.from('settings').upsert({ key: 'party_code', value: newCode }, { onConflict: 'key' });
        state.partyCode = newCode;
        localStorage.removeItem('voted_song_ids');
        loadAppSettings();
        loadRequests();
        loadPhotos();
        toonPopup(`🎉 Nieuw feest gestart! Code: ${newCode}`);
      } catch(e) {
        toonPopup('Fout bij starten nieuw feest.');
      }
    }

    async function saveWelcomeText() {
      const txt = document.getElementById('welcome-text-input').value.trim();
      await dbClient.from('settings').upsert({ key: 'welcome_text', value: txt }, { onConflict: 'key' });
      loadAppSettings();
      toonPopup('Welkomsttekst opgeslagen!');
    }

    async function savePhotoboothSetting() {
      const isChecked = document.getElementById('dj-photobooth-toggle').checked;
      await dbClient.from('settings').upsert({ key: 'photobooth_active', value: isChecked ? 'true' : 'false' }, { onConflict: 'key' });
      loadAppSettings();
      toonPopup(isChecked ? 'Fotobooth ingeschakeld! 📸' : 'Fotobooth uitgeschakeld.');
    }

    function renderBlacklistUI() {
      const c = document.getElementById('blacklist-words-container');
      if (!c) return;
      if (state.blacklist.length === 0) {
        c.innerHTML = '<span style="font-size:0.8rem; color:var(--text-sub);">Geen zwarte lijst woorden.</span>';
        return;
      }
      c.innerHTML = state.blacklist.map(w => `
        <span class="badge" style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.1);">
          ${w} <span style="cursor:pointer; color:var(--danger-color); font-weight:bold;" onclick="removeBlacklistWord('${w}')">×</span>
        </span>
      `).join('');
    }

    async function addBlacklistWord() {
      const input = document.getElementById('blacklist-word-input');
      const word = input.value.trim().toLowerCase();
      if (!word) return;
      if (!state.blacklist.includes(word)) {
        state.blacklist.push(word);
        await dbClient.from('settings').upsert({ key: 'blacklist', value: JSON.stringify(state.blacklist) }, { onConflict: 'key' });
        input.value = '';
        renderBlacklistUI();
        toonPopup('Blacklist bijgewerkt.');
      }
    }

    async function removeBlacklistWord(word) {
      state.blacklist = state.blacklist.filter(w => w !== word);
      await dbClient.from('settings').upsert({ key: 'blacklist', value: JSON.stringify(state.blacklist) }, { onConflict: 'key' });
      renderBlacklistUI();
      toonPopup('Woord verwijderd.');
    }

    async function loadPromoCard() {
      if (!dbClient) return;
      const { data } = await dbClient.from('settings').select('value').eq('key', 'promo_card').maybeSingle();
      let promo = defaultPromoCard;
      if (data && data.value) { try { promo = JSON.parse(data.value); } catch(e){} }
      
      const tIn = document.getElementById('promo-title-input');
      const sIn = document.getElementById('promo-subtitle-input');
      if (tIn && document.activeElement !== tIn) tIn.value = promo.title || '';
      if (sIn && document.activeElement !== sIn) sIn.value = promo.subtitle || '';

      const linksContainer = document.getElementById('promo-links-container');
      if (linksContainer) {
        let html = '';
        if (promo.whatsapp_active && promo.whatsapp) html += `<a href="${promo.whatsapp}" target="_blank" class="btn btn-secondary" style="justify-content: flex-start; gap: 12px;"><span>💬</span> WhatsApp Boekingen</a>`;
        if (promo.email_active && promo.email) html += `<a href="mailto:${promo.email}" target="_blank" class="btn btn-secondary" style="justify-content: flex-start; gap: 12px;"><span>✉️</span> E-mail Contact</a>`;
        if (promo.instagram_active && promo.instagram) html += `<a href="${promo.instagram}" target="_blank" class="btn btn-secondary" style="justify-content: flex-start; gap: 12px;"><span>📸</span> Instagram</a>`;
        if (promo.tiktok_active && promo.tiktok) html += `<a href="${promo.tiktok}" target="_blank" class="btn btn-secondary" style="justify-content: flex-start; gap: 12px;"><span>🎵</span> TikTok</a>`;
        linksContainer.innerHTML = html;
      }
    }

    async function savePromoCard() {
      const promo = {
        title: document.getElementById('promo-title-input').value.trim(),
        subtitle: document.getElementById('promo-subtitle-input').value.trim(),
        whatsapp_active: true, whatsapp: defaultPromoCard.whatsapp,
        email_active: true, email: defaultPromoCard.email
      };
      await dbClient.from('settings').upsert({ key: 'promo_card', value: JSON.stringify(promo) }, { onConflict: 'key' });
      loadPromoCard();
      toonPopup('Promo opgeslagen!');
    }

    function downloadCSV() {
      if (state.requests.length === 0) {
        toonPopup('Geen data om te exporteren.');
        return;
      }
      let csv = "Titel,Artiest,Stemmen,Status,Bericht\n";
      state.requests.forEach(r => {
        csv += `"${r.title}","${r.artist}",${r.votes || 1},"${r.status}","${r.note || ''}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `PartyBeats_Verzoekjes_${state.partyCode}.csv`;
      a.click();
    }
  </script>
</body>
</html>
